# ---- Login ----
# Your WhatsApp number with country code, digits only. If set, the bot prints a
# pairing code (WhatsApp > Linked devices > Link with phone number instead).
# Leave empty to get a QR code in the terminal instead.
PHONE_NUMBER=

# ---- Bot ----
# Characters that can start a command. "." means ".ping"; ".,!" allows .ping ,ping !ping
PREFIX=.
# Extra numbers (comma separated, with country code) allowed to run every command,
# besides your own account. Manage from WhatsApp with .setsudo / .delsudo / .sudo
# (once changed there, the saved list replaces this value).
SUDO=
BOT_NAME=wa-instinct
# Sticker pack metadata: "pack;author"
STICKER_PACK=wa-instinct;me
# Default language for reply strings (only "en" for now)
LANG=en

# ---- Behaviour (all can be changed at runtime with .setvar) ----
ALWAYS_ONLINE=false
AUTO_READ=false            # true | false | p (personal) | g (groups)
AUTO_STATUS_VIEW=false
REJECT_CALL=false
ANTI_DELETE=false          # false | p (send to your own chat) | g (resend in the same chat) | <jid>
ANTI_EDIT=false
CMD_REACT=🪄              # reaction added when a command is received; false to disable
WARN_LIMIT=3
WARN_MESSAGE=⚠️ &mention warned (&remaining left)\n&reason
WARN_KICK_MESSAGE=🚫 &mention exceeded the warn limit and was removed
WARN_RESET_MESSAGE=✅ warnings for &mention reset
ANTILINK_MESSAGE=_Antilink detected: &mention removed_
ANTISPAM_MESSAGE=_Antispam detected: &mention removed_

# ---- Optional API keys ----
RMBG_KEY=
OPENWEATHER_KEY=
OMDB_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---- Logging ----
LOG_LEVEL=info             # trace | debug | info | warn | error
BAILEYS_LOG_LEVEL=silent

# .agent: full Claude Code (shell, files, skills) from WhatsApp for you + sudo users. Only settable here, not via .setvar.
AGENT_ENABLED=false
# Folder .agent works in (required when AGENT_ENABLED=true):
# AGENT_DIR=/home/you/project
