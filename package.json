{
  "name": "wa-instinct",
  "version": "0.1.0",
  "description": "A readable, plugin-based WhatsApp bot built on Baileys 7",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "nodemon",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pm2": "pm2 start ecosystem.config.cjs && pm2 save",
    "pm2:stop": "pm2 stop wa-instinct",
    "pm2:logs": "pm2 logs wa-instinct",
    "pm2:restart": "pm2 restart wa-instinct"
  },
  "license": "MIT",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "an-array-of-english-words": "^2.0.0",
    "baileys": "7.0.0-rc14",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.11.2",
    "jimp": "^1.6.0",
    "jsqr": "^1.4.0",
    "link-preview-js": "^3.1.0",
    "node-cache": "^5.1.2",
    "node-webpmux": "^3.2.1",
    "pdfkit": "^0.20.2",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "nodemon": "^3.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
